{
  "name": "fairbuild-schedule-of-values",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairbuild-schedule-of-values",
  "description": "Fairbuild Schedule of Values: the schedule of values line by line against what has been billed and what the field says is in place: lines billed ahead of progress (over billing), lines billed behind it (money not yet asked for), a schedule of values that does not add up to the contract, approved change orders missing from it, and billing on zero-value lines. Drafts the project manager memo. Never changes a billing.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairbuild-schedule-of-values": "bin/fairbuild-schedule-of-values.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairbuild-schedule-of-values.js demo",
    "eval": "node bin/fairbuild-schedule-of-values.js eval"
  },
  "dependencies": {
    "fairbuild-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairbuild-agents.git",
    "directory": "packages/fairbuild-schedule-of-values"
  },
  "homepage": "https://github.com/fpavia111-creator/fairbuild-agents/tree/main/packages/fairbuild-schedule-of-values#readme",
  "bugs": {
