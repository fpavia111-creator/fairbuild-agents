{
  "name": "fairbuild-retainage",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairbuild-retainage",
  "description": "Fairbuild Retainage: retainage both ways: what owners hold from you by job and what you hold from subcontractors. Retainage held at the wrong rate or past a stop point, completed jobs whose retainage is due or overdue to bill, release billed but not collected, subcontractor retainage released before the owner paid yours, and retainage you now owe a subcontractor. Drafts release requests. Never bills, pays or releases.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairbuild-retainage": "bin/fairbuild-retainage.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairbuild-retainage.js demo",
    "eval": "node bin/fairbuild-retainage.js eval"
  },
  "dependencies": {
    "fairbuild-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairbuild-agents.git",
    "directory": "packages/fairbuild-retainage"
  },
  "homepage": "https://github.com/fpavia111-creator/fairbuild-agents/tree/main/packages/fairbuild-retainage#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairbuild-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "construction",
    "contractors",
    "construction-accounting",
    "fairbuild",
    "retainage",
    "retention",
    "closeout"
  ]
}
