{
  "name": "fairbuild-submittals",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairbuild-submittals",
  "description": "Fairbuild Submittals: the submittal register worked back from the date material is needed on site: submittals not yet submitted past their latest submit date (required on site less lead time and review time), reviews running over the allowed days, revise-and-resubmit not resubmitted, third and later revisions, approvals that came after the order-by date, and spec sections with no submittal. Ages ball-in-court. Drafts reminders. Never approves or changes a submittal.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairbuild-submittals": "bin/fairbuild-submittals.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairbuild-submittals.js demo",
    "eval": "node bin/fairbuild-submittals.js eval"
  },
  "dependencies": {
    "fairbuild-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairbuild-agents.git",
    "directory": "packages/fairbuild-submittals"
  },
  "homepage": "https://github.com/fpavia111-creator/fairbuild-agents/tree/master/packages/fairbuild-submittals#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairbuild-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "construction",
    "contractors",
    "construction-accounting",
    "fairbuild",
    "submittals",
    "submittal-register",
    "lead-time",
    "procore"
  ]
}
