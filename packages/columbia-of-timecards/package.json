{
  "name": "columbia-of-timecards",
  "version": "0.1.0",
  "description": "Columbia of Timecards: field timecards against crew assignments, job status and the cost codes in each job budget: hours on a job the worker was not assigned to that day, on a closed job, or on a cost code the job has no budget for; days longer than your limit; weekend work; and entries made twice. Worker names are masked in what the AI model sees. Drafts recode requests. Never edits a timecard or runs payroll.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "columbia-of-timecards": "bin/columbia-of-timecards.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/columbia-of-timecards.js demo",
    "eval": "node bin/columbia-of-timecards.js eval"
  },
  "dependencies": {
    "fairbuild-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairbuild-agents.git",
    "directory": "packages/columbia-of-timecards"
  },
  "homepage": "https://github.com/fpavia111-creator/fairbuild-agents/tree/main/packages/columbia-of-timecards#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairbuild-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "construction",
    "contractors",
    "construction-accounting",
    "fairbuild",
    "timecards",
    "labor-allocation",
    "job-costing"
  ]
}
