{
  "name": "fairbuild-delivery-tickets",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairbuild-delivery-tickets",
  "description": "Fairbuild Delivery Tickets: supplier invoice lines for materials against the signed delivery tickets and your agreed prices: quantities billed past what was delivered, prices above the agreed price, extensions that do not add up, a ticket billed twice, lines with no ticket, and tickets not yet invoiced (to accrue). Drafts supplier credit requests. Never pays a supplier.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairbuild-delivery-tickets": "bin/fairbuild-delivery-tickets.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairbuild-delivery-tickets.js demo",
    "eval": "node bin/fairbuild-delivery-tickets.js eval"
  },
  "dependencies": {
    "fairbuild-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairbuild-agents.git",
