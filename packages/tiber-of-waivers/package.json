{
  "name": "tiber-of-waivers",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/tiber-of-waivers",
  "description": "Tiber of Waivers: every payment to a subcontractor or supplier matched to its lien waivers: payments made without a conditional waiver, unconditional waivers missing after the payment cleared, waivers for less than was paid, unsigned waivers, and final payments without final waivers. Drafts waiver requests. Never files or releases a lien and never pays.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "tiber-of-waivers": "bin/tiber-of-waivers.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/tiber-of-waivers.js demo",
    "eval": "node bin/tiber-of-waivers.js eval"
  },
  "dependencies": {
    "fairbuild-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairbuild-agents.git",
    "directory": "packages/tiber-of-waivers"
  },
  "homepage": "https://github.com/fpavia111-creator/fairbuild-agents/tree/main/packages/tiber-of-waivers#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairbuild-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "construction",
    "contractors",
    "construction-accounting",
    "fairbuild",
    "lien-waivers",
    "conditional-waiver",
    "unconditional-waiver"
  ]
}
