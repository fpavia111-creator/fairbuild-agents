    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairbuild-three-way-match": "bin/fairbuild-three-way-match.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
