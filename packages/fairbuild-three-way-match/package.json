    "demo": "node bin/fairbuild-three-way-match.js demo",
    "eval": "node bin/fairbuild-three-way-match.js eval"
  },
  "dependencies": {
    "fairbuild-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
