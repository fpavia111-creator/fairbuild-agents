{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/oder-of-submittals",
  "title": "Oder of Submittals",
  "description": "Oder of Submittals: the submittal register worked back from the date material is needed on site…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairbuild-agents",
    "source": "github",
    "subfolder": "packages/oder-of-submittals"
  },
  "websiteUrl": "https://fair-agents.com/fairbuild.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "oder-of-submittals",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
