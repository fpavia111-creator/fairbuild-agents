{
  "name": "fairbuild-job-cash-flow",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairbuild-job-cash-flow",
  "description": "Fairbuild Job Cash Flow: cash flow by job from receipts and disbursements: net cash position per job, jobs where you have paid out more than you collected, invoices to the owner unpaid past your collection days, and jobs negative two months running, with a month-by-month table. Drafts collection letters. Never moves money or changes a payment.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairbuild-job-cash-flow": "bin/fairbuild-job-cash-flow.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairbuild-job-cash-flow.js demo",
    "eval": "node bin/fairbuild-job-cash-flow.js eval"
  },
  "dependencies": {
    "fairbuild-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairbuild-agents.git",
    "directory": "packages/fairbuild-job-cash-flow"
  },
  "homepage": "https://github.com/fpavia111-creator/fairbuild-agents/tree/master/packages/fairbuild-job-cash-flow#readme",
  "bugs": {
