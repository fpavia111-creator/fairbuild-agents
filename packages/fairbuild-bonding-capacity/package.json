{
  "name": "fairbuild-bonding-capacity",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairbuild-bonding-capacity",
  "description": "Fairbuild Bonding Capacity: a bonding capacity summary from your job list and the single and aggregate limits your surety gave you: bonded backlog against the aggregate limit, jobs over the single-job limit, bonded jobs forecast at a loss, and whether the bonded bids you are chasing fit in what is left. Drafts the summary for your surety broker. Never requests a bond or sends financials; not surety advice.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairbuild-bonding-capacity": "bin/fairbuild-bonding-capacity.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairbuild-bonding-capacity.js demo",
    "eval": "node bin/fairbuild-bonding-capacity.js eval"
  },
  "dependencies": {
    "fairbuild-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairbuild-agents.git",
    "directory": "packages/fairbuild-bonding-capacity"
  },
  "homepage": "https://github.com/fpavia111-creator/fairbuild-agents/tree/master/packages/fairbuild-bonding-capacity#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairbuild-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "construction",
    "contractors",
    "construction-accounting",
    "fairbuild",
    "bonding-capacity",
    "surety",
    "backlog"
  ]
}
