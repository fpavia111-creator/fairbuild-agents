{
  "name": "platte-of-releases",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/platte-of-releases",
  "description": "Platte of Releases: the release check before a subcontractor is paid: project manager approval, the owner paid for that month (pay-when-paid, if you use it), a conditional lien waiver for the invoice, a current insurance certificate, a W-9 on file and retainage withheld at the subcontract rate. Each invoice is cleared or held with its reasons, and payment releases are recorded only after one named person's click. Never pays.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "platte-of-releases": "bin/platte-of-releases.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/platte-of-releases.js demo",
    "eval": "node bin/platte-of-releases.js eval"
  },
  "dependencies": {
    "fairbuild-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairbuild-agents.git",
    "directory": "packages/platte-of-releases"
  },
  "homepage": "https://github.com/fpavia111-creator/fairbuild-agents/tree/main/packages/platte-of-releases#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairbuild-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "construction",
    "contractors",
    "construction-accounting",
    "fairbuild",
    "payment-release",
    "pay-when-paid",
    "subcontractor-payments"
  ]
}
