{
  "name": "fairbuild-pay-applications",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairbuild-pay-applications",
  "description": "Fairbuild Pay Applications: checks the arithmetic of a pay application in the G702/G703 layout before it goes out or before you approve a subcontractor's: each line's completed and stored total, percent and balance, retainage at your rates, lines billed past their scheduled value, work from previous applications that does not match the last one, and the summary page totals down to the payment due. Never submits or approves a pay application.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairbuild-pay-applications": "bin/fairbuild-pay-applications.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairbuild-pay-applications.js demo",
    "eval": "node bin/fairbuild-pay-applications.js eval"
  },
  "dependencies": {
    "fairbuild-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairbuild-agents.git",
    "directory": "packages/fairbuild-pay-applications"
  },
  "homepage": "https://github.com/fpavia111-creator/fairbuild-agents/tree/master/packages/fairbuild-pay-applications#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairbuild-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "construction",
    "contractors",
    "construction-accounting",
    "fairbuild",
    "pay-application",
    "g702",
    "g703",
    "progress-billing"
  ]
}
